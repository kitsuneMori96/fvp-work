# 个人游戏存档: 绝不上公开仓库
save_backup_20251001/
# Python 临时文件
__pycache__/
*.pyc
# Windows 残留
Thumbs.db
Desktop.ini
# Rust 构建产物 (fvp-preview 用 .cargo/config.toml 把 target 指到 WSL 侧，
# 即使如此也不进仓；Cargo.lock 保留以锁定可复现构建)
fvp-preview/target/
# 编辑器本地路径配置（网页配置区落盘，含个人目录，不进仓）
fvp-preview/server_config.json
**/*.rs.bk
# 构建产物 (savefix 编译输出, 使用时本地生成)
savefix/*.dll
savefix/*.exe
savefix/*.obj
savefix/*.pdb
savefix/*.ilk
savefix/*.exp
savefix/*.lib
